{
  "expo": {
    "name": "Function",
    "slug": "function",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "function",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f7f7fb",
    "ios": {
      "bundleIdentifier": "com.studentfunction.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Function shows what's on near you on the live map.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "associatedDomains": [
        "applinks:studentfunction.com"
      ]
    },
    "android": {
      "package": "com.studentfunction.app",
      "adaptiveIcon": {
        "backgroundColor": "#DA291C",
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "monochromeImage": "./assets/brand/monochrome-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "studentfunction.com",
              "pathPrefix": "/e/"
            },
            {
              "scheme": "https",
              "host": "studentfunction.com",
              "pathPrefix": "/s/"
            },
            {
              "scheme": "https",
              "host": "studentfunction.com",
              "pathPrefix": "/social/"
            },
            {
              "scheme": "https",
              "host": "studentfunction.com",
              "pathPrefix": "/u/"
            },
            {
              "scheme": "https",
              "host": "studentfunction.com",
              "pathPrefix": "/auth/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/favicon.png",
      "name": "Function",
      "shortName": "Function",
      "description": "London's student social life, all in one place. Societies, events and socials for students at every London university, on one live map.",
      "themeColor": "#DA291C",
      "backgroundColor": "#f7f7fb"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#DA291C",
          "image": "./assets/brand/splash-glyph.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/figtree/400Regular/Figtree_400Regular.ttf",
            "node_modules/@expo-google-fonts/figtree/600SemiBold/Figtree_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/figtree/700Bold/Figtree_700Bold.ttf",
            "node_modules/@expo-google-fonts/bricolage-grotesque/700Bold/BricolageGrotesque_700Bold.ttf",
            "node_modules/@expo-google-fonts/bricolage-grotesque/800ExtraBold/BricolageGrotesque_800ExtraBold.ttf"
          ]
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Function uses your location to show what's on near you and walking directions. It stays on your phone."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Function uses your photos for your profile picture and your 5 photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/monochrome-icon.png",
          "color": "#DA291C",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
