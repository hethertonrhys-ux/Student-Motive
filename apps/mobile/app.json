{
  "expo": {
    "name": "Function",
    "slug": "function",
    "version": "1.4.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0b973917-964c-41f7-89f4-c2a2abb81265"
    },
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "function",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f7f7fb",
    "ios": {
      "bundleIdentifier": "com.studentfunction.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:studentfunction.com"
      ]
    },
    "android": {
      "package": "com.studentfunction.app",
      "adaptiveIcon": {
        "backgroundColor": "#DA291C",
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "monochromeImage": "./assets/brand/monochrome-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "studentfunction.com",
              "pathPrefix": "/e/"
            },
            {
              "scheme": "https",
              "host": "studentfunction.com",
              "pathPrefix": "/s/"
            },
            {
              "scheme": "https",
              "host": "studentfunction.com",
              "pathPrefix": "/social/"
            },
            {
              "scheme": "https",
              "host": "studentfunction.com",
              "pathPrefix": "/u/"
            },
            {
              "scheme": "https",
              "host": "studentfunction.com",
              "pathPrefix": "/claim/"
            },
            {
              "scheme": "https",
              "host": "studentfunction.com",
              "pathPrefix": "/hub"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/favicon.png",
      "name": "Function",
      "shortName": "Function",
      "description": "London's student social life, all in one place. Societies, events and socials for students at every London university, on one live map.",
      "themeColor": "#DA291C",
      "backgroundColor": "#f7f7fb"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#DA291C",
          "image": "./assets/brand/splash-glyph.png",
          "imageWidth": 160
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Function uses your location to show what's on near you and to work out walking directions.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Function uses your photos for your profile picture, your 5 photos and the photos and videos you send in chats.",
          "cameraPermission": "Function uses the camera to take photos and videos to send in chats, and to scan friends' QR codes.",
          "microphonePermission": "Function uses the microphone to record sound for videos you send in chats."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/monochrome-icon.png",
          "color": "#DA291C",
          "defaultChannel": "default"
        }
      ],
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Function uses the camera to take photos and videos to send in chats, and to scan friends' QR codes.",
          "microphonePermission": "Function uses the microphone to record sound for videos you send in chats.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.studentfunction",
          "enableGooglePay": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "0b973917-964c-41f7-89f4-c2a2abb81265"
      }
    },
    "owner": "studentmotive"
  }
}
