{
  "expo": {
    "name": "Function",
    "slug": "function",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "function",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f7f7fb",
    "ios": {
      "bundleIdentifier": "com.studentfunction.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Function shows what's on near you on the live map."
      }
    },
    "android": {
      "package": "com.studentfunction.app",
      "adaptiveIcon": {
        "backgroundColor": "#DA291C",
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "monochromeImage": "./assets/brand/monochrome-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/favicon.png",
      "name": "Function",
      "shortName": "Function",
      "description": "London's student social life, all in one place. Societies, events and socials for students at LSE, UCL, King's and Imperial, on one live map.",
      "themeColor": "#DA291C",
      "backgroundColor": "#f7f7fb"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#DA291C",
          "image": "./assets/brand/splash-glyph.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/figtree/400Regular/Figtree_400Regular.ttf",
            "node_modules/@expo-google-fonts/figtree/600SemiBold/Figtree_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/figtree/700Bold/Figtree_700Bold.ttf",
            "node_modules/@expo-google-fonts/bricolage-grotesque/700Bold/BricolageGrotesque_700Bold.ttf",
            "node_modules/@expo-google-fonts/bricolage-grotesque/800ExtraBold/BricolageGrotesque_800ExtraBold.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
